# URL Web App Google Apps Script setelah di-deploy, contoh:
# https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
VITE_API_BASE_URL=
# Google OAuth Web client ID untuk login akun Ngaji Ceria
VITE_GOOGLE_CLIENT_ID=
# Optional Colyseus server, for example: ws://localhost:2567
VITE_COLYSEUS_URL=
# Optional GLB overrides. Leave empty to use the bundled battle models.
VITE_NGAJI_CERIA_PLAYER_MODEL=
VITE_NGAJI_CERIA_MONSTER_MODEL=
